msgid "Please note: free tiles from MapQuest have been discontinued without use of an API key"
msgstr "Bitte beachte: kostenlose Kacheln von MapQuest gibt es nicht mehr ohne API-Schlüssel."

#: class.plugin-settings.php:231 class.plugin-settings.php:370
msgid "here"
msgstr "hier"

#: class.plugin-settings.php:230
msgid "See more tile servers"
msgstr "Mehr Kartenkachel-Server anzeigen"

